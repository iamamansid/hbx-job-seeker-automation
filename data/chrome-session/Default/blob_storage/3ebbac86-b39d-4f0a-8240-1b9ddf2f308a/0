ommon.text.TextAttribute"},{"start":1175,"length":188,"detailData":{"jobPostingName":null,"hyperlink":null,"profileFamiliarName":null,"color":null,"companyName":null,"icon":null,"epoch":null,"systemImage":null,"textLink":null,"listItemStyle":null,"groupName":null,"hyperlinkOpenExternally":null,"listStyle":null,"profileFullName":null,"stringFieldReference":null,"learningCourseName":null,"profileMention":null,"style":"LIST","schoolName":null,"hashtag":null},"$recipeTypes":["com.linkedin.a86ec3a7ab50c2c801e0395a86ff19c0"],"$type":"com.linkedin.voyager.dash.common.text.TextAttribute"}],"accessibilityTextAttributesV2":[],"accessibilityText":null,"$recipeTypes":["com.linkedin.459b39275484867cf3e3d37c7345039b"],"$type":"com.linkedin.voyager.dash.common.text.TextViewModel"},"repostedJob":false,"trustReviewDecision":null,"title":"Backend Developer (Database & Data Processing)","$recipeTypes":["com.linkedin.7565c5d1cf49540e44a3ae98be36ad3c"],"posterId":null,"$type":"com.linkedin.voyager.dash.jobs.JobPosting","createdAt":1771390849000,"contentSource":"JOBS_PREMIUM_OFFLINE","entityUrn":"urn:li:fsd_jobPosting:4374494012","*location":"urn:li:fsd_geo:104769905","*workplaceTypesResolutionResults":["urn:li:fsd_workplaceType:3"]},{"companyDetails":{"$recipeTypes":["com.linkedin.7397df9daf3daee6b2674bb755e1e2ed"],"jobCompany":{"rawCompanyName":null,"*company":"urn:li:fsd_company:105029621"},"$type":"com.linkedin.voyager.dash.jobs.JobPostingCompany"},"trackingUrn":"urn:li:jobPosting:4371739176","jobState":"LISTED","*jobWorkplaceTypes":["urn:li:fsd_workplaceType:3"],"description":{"textDirection":"USER_LOCALE","text":"VALE Partners has been engaged by a high-growth technology startup to help find a Senior Backend Engineer to own and evolve a critical layer of their groundbreaking B2B SaaS platform. They're well-funded and have established product-market fit, having already found a customer base in internationally recognised organisations.\nThis is a foundational role in the team, bridging the gap between raw data ingestion and user-facing interfaces and insights. We are looking for a backend-focused engineer who enjoys the challenge of structuring data systems. You will hold the keys to system architecture, designing the APIs and services that guarantee speed, precision, and reliability across the platform.\n Role OverviewBuild and scale the Node.js backend services and APIs that deliver real-time data to customer interfaces.Architect a comprehensive semantic layer to standardise how metrics and logic are defined across the application.Optimise database performance and query efficiency to handle increasing data loads and complexity.Drive the technical roadmap for the analytics infrastructure, preparing the system for future event-driven capabilities and machine learning integrations.\nWhat You'll Ideally HaveExperience building high performance data heavy applications using Node.js.Familiarity with semantic layer design, implementation and optimisation.A solid track record of architecting highly available, real-time data systems from the ground up.Experience with databases (ideally Postgres) in high performance/high throughput contexts.\nThis Role Will Interest You IfYou thrive in high-growth startup environments where you are given the autonomy to make significant architecture and technology choices.You enjoy the challenge of balancing performance, cost, and maintainability while building automated testing and monitoring systems.You want to play a lead role in shaping the technical direction of a platform that is evolving toward sophisticated AI/ML-driven insights.You are a self-motivated engineer who values end-to-end ownership and seeing the immediate impact of your work on the end-user experience.\nIf you'd like to apply for this role but are unsure about your suitability - please reach out! \nWith over 25 years of combined experience recruiting for the QLD technology market, VALE Partners love to help you see that you are suitable or assist you in any other way we can.\nRegan RoulstonDirector + Principal0478 687 951  | regan@valepartners.co","attributesV2":[{"start":0,"length":326,"detailData":{"jobPostingName":null,"hyperlink":null,"profileFamiliarName":null,"color":null,"companyName":null,"icon":null,"epoch":null,"systemImage":null,"textLink":null,"listItemStyle":null,"groupName":null,"hyperlinkOpenExternally":null,"listStyle":null,"profileFullName":null,"stringFieldReference":null,"learningCourseName":null,"profileMention":null,"style":"PARAGRAPH","schoolName":null,"hashtag":null},"$recipeTypes":["com.linkedin.a86ec3a7ab50c2c801e0395a86ff19c0"],"$type":"com.linkedin.voyager.dash.common.text.TextAttribute"},{"start":326,"length":1,"detailData":{"jobPostingName":null,"hyperlink":null,"profileFamiliarName":null,"color":null,"companyName":null,"icon":null,"epoch":null,"systemImage":null,"textLink":null,"listItemStyle":null,"groupName":null,"hyperlinkOpenExternally":null,"listStyle":null,"profileFullName":null,"stringFieldReference":null,"learningCourseName":null,"profileMention":null,"style":"PARAGRAPH","schoolName":null,"hashtag":null},"$recipeTypes":["com.linkedin.a86ec3a7ab50c2c801e0395a86ff19c0"],"$type":"com.linkedin.voyager.dash.common.text.TextAttribute"},{"start":327,"length":374,"detailData":{"jobPostingName":null,"hyperlink":null,"profileFamiliarName":null,"color":null,"companyName":null,"icon":null,"epoch":null,"systemImage":null,"textLink":null,"listItemStyle":null,"groupName":null,"hyperlinkOpenExternally":null,"listStyle":null,"profileFullName":null,"stringFieldReference":null,"learningCourseName":null,"profileMention":null,"style":"PARAGRAPH","schoolName":null,"hashtag":null},"$recipeTypes":["com.linkedin.a86ec3a7ab50c2c801e0395a86ff19c0"],"$type":"com.linkedin.voyager.dash.common.text.TextAttribute"},{"start":701,"length":1,"detailData":{"jobPostingName":null,"hyperlink":null,"profileFamiliarName":null,"color":null,"companyName":null,"icon":null,"epoch":null,"systemImage":null,"textLink":