th":73,"detailData":{"jobPostingName":null,"hyperlink":null,"profileFamiliarName":null,"color":null,"companyName":null,"icon":null,"epoch":null,"systemImage":null,"textLink":null,"listItemStyle":null,"groupName":null,"hyperlinkOpenExternally":null,"listStyle":null,"profileFullName":null,"stringFieldReference":null,"learningCourseName":null,"profileMention":null,"style":"BOLD","schoolName":null,"hashtag":null},"$recipeTypes":["com.linkedin.a86ec3a7ab50c2c801e0395a86ff19c0"],"$type":"com.linkedin.voyager.dash.common.text.TextAttribute"}],"accessibilityTextAttributesV2":[],"accessibilityText":null,"$recipeTypes":["com.linkedin.459b39275484867cf3e3d37c7345039b"],"$type":"com.linkedin.voyager.dash.common.text.TextViewModel"},"*jobPosting":"urn:li:fsd_jobPosting:4372800169","$recipeTypes":["com.linkedin.119d70fa61572d2c0cd7795922d4adaf"],"$type":"com.linkedin.voyager.dash.jobs.JobDescription"},{"thirdPartyLabel":null,"entityUrn":"urn:li:fsd_jobDescription:4341030313","postedOnText":"Posted on Dec 2, 2025.","header":{"textDirection":"USER_LOCALE","text":"About the job","attributesV2":[],"accessibilityTextAttributesV2":[],"accessibilityText":null,"$recipeTypes":["com.linkedin.459b39275484867cf3e3d37c7345039b"],"$type":"com.linkedin.voyager.dash.common.text.TextViewModel"},"descriptionText":{"textDirection":"USER_LOCALE","text":"Propeller is on a mission to take the guesswork out of moving dirt - reducing wasted fuel, time, and money. We do this through the power of maps.\n\nOur customers use Propeller’s integrated hardware and software products to capture accurate 3D versions of their worksites. With over 50,000 worksites worldwide using Propeller’s smart survey technology, we empower project teams to map, measure, and manage site activity.\n\nPropeller empowers everyone to approach, own, and solve problems creatively. We’re data nerds who care about impact, honesty, and each other. We take pride in being a great place to work. We are proud to be recipients of BI Group's Excellence in Customer Experience award and Inspiring Workplaces of Australasia, being recognized as a Fast Company and BuiltIn Best Place to Work. You can learn more about us on Glassdoor.\n\nYour Mission\n\nAs a Senior Backend Engineer at Propeller, you will play a key role in building and improving our existing API to allow better integration with other products our customers use, as well as enabling our customers to get better access to their data on our platform.\n\nYou will be part of the Platform team, focusing on developing high-performance shared applications and tools that enable our entire engineering team to deliver great work, in addition to building out applications and services that are used by our customers on a daily basis.\n\nThis role is cross-cutting in nature, offering the opportunity to work on projects across multiple teams and products, creating a wide impact on everything engineering at Propeller.\n\nYour Skills\n\nYou bring at least 6 years of full-time experience as a Software Engineer, with strong backend skills in either the Node.js or Python ecosystem.You have experience with AWS (or another cloud provider) and are comfortable working in cloud-based environments.You’re a good communicator and have a desire to provide mentorship to engineers around you. You’re solutions driven and you have the ability to parachute into existing teams and products and build solutions that are fit for purpose.You have built APIs for a variety of products and industries. You’re a team player and a great collaborator, connecting your work with other teams to ensure our customers get the most value from our products. \n\nBenefits\n\nEmployee share optionsProfessional development budget and leaveThe opportunity to take part in our mentorship programMental health resources Monthly telephone and/or internet allowancePaid primary & secondary parental leave policies Hybrid work arrangements and WFH equipment provided","attributesV2":[{"start":641,"length":10,"detail