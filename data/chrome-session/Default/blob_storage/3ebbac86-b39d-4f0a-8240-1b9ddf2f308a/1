yUrn":"urn:li:fs_saveAction:(SAVE,urn:li:fsd_jobPosting:4373672455)","$recipeTypes":["com.linkedin.eacc702a42d75d12069ff68faf4f22c9"],"$type":"com.linkedin.voyager.dash.feed.SaveState"},{"saved":false,"entityUrn":"urn:li:fsd_saveState:(SAVE,urn:li:fsd_jobPosting:4364718714)","preDashEntityUrn":"urn:li:fs_saveAction:(SAVE,urn:li:fsd_jobPosting:4364718714)","$recipeTypes":["com.linkedin.eacc702a42d75d12069ff68faf4f22c9"],"$type":"com.linkedin.voyager.dash.feed.SaveState"},{"saved":false,"entityUrn":"urn:li:fsd_saveState:(SAVE,urn:li:fsd_jobPosting:4323916218)","preDashEntityUrn":"urn:li:fs_saveAction:(SAVE,urn:li:fsd_jobPosting:4323916218)","$recipeTypes":["com.linkedin.eacc702a42d75d12069ff68faf4f22c9"],"$type":"com.linkedin.voyager.dash.feed.SaveState"},{"thirdPartyLabel":null,"entityUrn":"urn:li:fsd_jobDescription:4373890325","postedOnText":"Posted on Feb 17, 2026.","header":{"textDirection":"USER_LOCALE","text":"About the job","attributesV2":[],"accessibilityTextAttributesV2":[],"accessibilityText":null,"$recipeTypes":["com.linkedin.459b39275484867cf3e3d37c7345039b"],"$type":"com.linkedin.voyager.dash.common.text.TextViewModel"},"descriptionText":{"textDirection":"USER_LOCALE","text":"Our client is building smart, AI-powered (and robotics!) tools that sit at the centre of workforce safety, compliance, and onboarding. From logistics warehouses to high-risk construction zones, their systems ensure that every person on-site is trained, registered, and ready before they even walk through the door.\n \n Driven by growth across all of their products, they’re now looking for a Senior Node.js engineer to join their product engineering team. You’ll be a driving force behind one of the most practical, purpose-driven platforms in the country, used daily by thousands of contractors and staff across Australia.\n\n You’ll Be Working On \nBackend systems powering staff and contractor compliance workflowsBuilding scalable microservices in Node.js and TypeScript (React FE).Integrating with learning platforms, safety alerts, and workforce management toolsPartnering with senior engineers and product teams to learn fast and contribute meaningfullyExploring emerging tools — including AI-based systems — to improve decision-making and risk detectionExperience Required:\n10+ years’ experience in backend development (Node.js preferred)Expert understanding of TypeScript, APIs, and server-side design principlesA fast learner who’s excited by both the product and the problem it’s solvingSomeone with strong communication and stakeholder engagement skills who has the experience to lead and deliver end-to-end enterprise software build projects. Whilst the role is back-end focused, we expect seniors to be full stack. \nWhat’s In It for You?\nWork for a massively successful and profitable SaaS company who are solely focused on building high-quality software products that deliver real user value.Work in a close-knit culture of software product excellence, with a flat company structure and senior executives who are all proven technical experts from software developer backgrounds – no need to explain or justify why building the right way is best.Work across a modern stack with the freedom to experiment and improveYou will be given trust and ownership, whilst working alongside other skilled and passionate software engineers.Own end-to-end greenfield solution buildsWork with and explore the latest AI tooling and agentic solution buildsTackle real-world safety and compliance challenges with practical impactJoin a team that values curiosity, kindness, and courage \nWe have exclusively recruited the technology team for our client for over 5 years and will provide suitable candidates with a detailed brief on the company and this role. If you are looking to join a SaaS software business that understands the people, process, and technology recipe to build high-value software, then please call Software Recruitment Practice Lead Dan Gordon on 0401 912 645 or otherwise 'apply now'. Job#268971\n\n\nPeoplebank and Leaders IT are committed to creating a diverse and inclusive workplace where everyone belongs. We welcome applications from people of all backgrounds, identities, and experiences. If you need adjustments to the recruitment process due to your circumstances, please let us know—we’re here to support you.","attributesV2":[{"start":625,"length":22,"detailData":{"jobPostingName":null,"hyperlink":null,"profileFamiliarName":null,"color":null,"companyName":null,"icon":null,"epoch":null,"systemImage":null,"textLink":null,"listItemStyle":null,"groupName":null,"hyperlinkOpenExternally":null,"listStyle":null,"profileFullName":null,"stringFieldReference":null,"learningCourseName":null,"profileMention":null,"style":"BOLD","schoolName":null,"hashtag":null},"$recipeTypes":["com.linkedin.a86ec3a7ab50c2c801e0395a86ff19c0"],"$type":"com.linkedin.voyager.dash.common.text.TextAttribute"},{"start":647,"length":66,"detailData":{"jobPostingName":null,"hyperlink":null,"profileFamiliarName":null,"color":null,"companyName":null,"icon":null,"epoch":null,"systemImage":null,"textLink":null,"listItemStyle":null,"groupName":null,"hyperlinkOpenExternally":null,"listStyle":null,"profileFullName":null,"stringFieldReference":null,"learningCourseName":null,"profileMention":null,"style":"LIST_ITEM","schoolName":null,"hashtag":null},"$recipeTypes":["com.linkedin.a86ec3a7ab50c2c801e0395a86ff19c0"],"$type":"com.linkedin.voyager.dash.common.text.TextAttribute"},{"start":713,"length":69,"detailData":{"jobPostingName":null,"hyperlink":null,"profileFamiliarName":null,"color":null,"companyName":null,"icon":null,"epoch":null,"systemImage":null,"textLink":null,"listItemStyle":null,"groupName":null,"hyperlinkOpenExternally":null,"listStyle":null,"profileFullName":null,"stringFieldReference":null,"learningCourseName":null,"profileMention":null,"style":"LIST_ITEM","schoolName":null,"hashtag":null},"$recipeTypes":["com.linkedin.a86ec3a7ab50c2c801e0395a86ff19c0"],"$type":"com