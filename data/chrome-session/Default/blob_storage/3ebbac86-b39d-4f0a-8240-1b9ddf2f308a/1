FullName":null,"stringFieldReference":null,"learningCourseName":null,"profileMention":null,"style":"LIST_ITEM","schoolName":null,"hashtag":null},"$recipeTypes":["com.linkedin.a86ec3a7ab50c2c801e0395a86ff19c0"],"$type":"com.linkedin.voyager.dash.common.text.TextAttribute"},{"start":2358,"length":283,"detailData":{"jobPostingName":null,"hyperlink":null,"profileFamiliarName":null,"color":null,"companyName":null,"icon":null,"epoch":null,"systemImage":null,"textLink":null,"listItemStyle":null,"groupName":null,"hyperlinkOpenExternally":null,"listStyle":null,"profileFullName":null,"stringFieldReference":null,"learningCourseName":null,"profileMention":null,"style":"LIST","schoolName":null,"hashtag":null},"$recipeTypes":["com.linkedin.a86ec3a7ab50c2c801e0395a86ff19c0"],"$type":"com.linkedin.voyager.dash.common.text.TextAttribute"}],"accessibilityTextAttributesV2":[],"accessibilityText":null,"$recipeTypes":["com.linkedin.459b39275484867cf3e3d37c7345039b"],"$type":"com.linkedin.voyager.dash.common.text.TextViewModel"},"*jobPosting":"urn:li:fsd_jobPosting:4365722012","$recipeTypes":["com.linkedin.119d70fa61572d2c0cd7795922d4adaf"],"$type":"com.linkedin.voyager.dash.jobs.JobDescription"},{"thirdPartyLabel":null,"entityUrn":"urn:li:fsd_jobDescription:4358470272","postedOnText":"Posted on Jan 7, 2026.","header":{"textDirection":"USER_LOCALE","text":"About the job","attributesV2":[],"accessibilityTextAttributesV2":[],"accessibilityText":null,"$recipeTypes":["com.linkedin.459b39275484867cf3e3d37c7345039b"],"$type":"com.linkedin.voyager.dash.common.text.TextViewModel"},"descriptionText":{"textDirection":"USER_LOCALE","text":"Work on end-to-end customer experience focused projects in a dynamic FMCG industryCustomer experience projects: Focusing on backend developmentDon’t settle for Ordinary: Work in an office where a Bar is in the reception5 days / weeks | Fixed term contract through to Nov 2026\n\n\nDon’t settle for ordinary – we welcome those on the hunt for more! At Lion, we believe that life is short and working in Technology just feels different when you sit at the heart of human connection and good times. So put a spark back in your day, working in an exciting industry as unique as you and with outstanding brands that those around you know and love like James Squire, Hahn, Stone & Wood and Tooheys!\n\nYour day in the life of a Lion Corporate Specialist\n\nThis is a great opportunity to join Lion with its range of iconic brands in this Parental leave 5-day, full time position through to November 2026.\n\nBased in our Sydney head office you will be reporting into the CX Technology Chapter Manager and be a part of this small dynamic team working on full end to end emerging technology projects.\n\nYou will design and develop customer centric digital solutions focussing on the backend engineering using .Net to manage server-side logic and integrate data sources with frontend interfaces via APIs in a serverless cloud environment. You will get involved with end-to-end development and opportunity to support green field projects\n\nDesign & DevelopmentBackend EngineeringAgile DeliveryMaintenance & OptimisationPlanning and DesignInnovation\n\n\nTo be successful you will bring\n\nStrong .NET development experience with back-end emphasis along with good understanding of front-end technologies.Experience provisioning and managing AWS serverless architecture.Exposure to customer-centric software development. Preferable e-commerce B2B and transactional projects.Strong analytical and problem-solving skillsSkilled at working with both technical and non-technical stakeholders to translate business requirements into technical deliverables.Enjoy building applications from scratch and seeing projects end-to-end.Experience working in an Agile scrum team in a DevOps environment.Skilled at translating complex technical concepts into clear, accessible language for non-technical stakeholders \n\n\nApply now for a career less ordinary!\n\nAt Lion, we offer ‘growth on tap’ and you’ll get hooked on reaching higher with each new challenge. No matter your chosen career, for those thirsty for more we have endless experiences to learn and grow. But don’t worry, you don’t have to choose between your career and other life priorities – we have fantastic people, policies and programs in place to empower you to lead a career and life less ordinary.\n\nWe’re a certified B Corp, which means we care about people, planet and purpose—not just profit. We’re committed to diversity, equity and inclusion, and we celebrate the unique perspectives that help us grow and innovate. We intentionally embrace difference and cultivate belonging every day, whether through our investment in our Reconciliation journey through our Innovate RAP, our commitment to gender pay equity or providing progressive people policies.\n\nIf you need specific support or accessibility adjustments at any stage of the recruitment process, please let us know at talentacquisition@lionco.com so we can make sure that your recruitment process is fair and we enable you to shine. This includes tailored support for First Nations people, individuals with disabilities, those who are neurodivergent, and people who identify as transgender or gender diverse as we understand the unique challenges and concerns you may face.","attributesV2":[{"start":0,"length":82,"detailData":{"jobPostingName":null,"hyperlink":null,"profileFamiliarName":null,"color":null,"companyName":null,"icon":null,"epoch":null,"systemImage":null,"textLink":null,"listItemStyle":null,"groupName":null,"hyperlinkOpenExternally":null,"listStyle":null,"profileFullName":null,"stringFieldReference":null,"learningCourseName":null,"profileMention":null,"style":"LIST_ITEM","schoolName":null,"hashtag":null},"$recipeTypes":["com.linkedin.a86ec3a7ab50c2c801e0395a86ff19c0"],"$type":"com.linkedin.voyager.dash.common.text.TextAttribute"},{"start":82,"length":61,"detailData":{"jobPostingName":null,"hyperlink":null,"profileFamiliarName":n