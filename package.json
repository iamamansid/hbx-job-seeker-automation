{
  "name": "seek-applier",
  "version": "1.0.0",
  "description": "Production-grade SEEK Australia automated job application system using Playwright and Gemini 2.5 Pro",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "login-setup": "ts-node src/scripts/loginSetup.ts",
    "start": "npm run build && node dist/index.js --once",
    "once": "npm run build && node dist/index.js --once",
    "schedule": "npm run build && node dist/index.js --schedule",
    "dry-run": "cross-env DRY_RUN=true npm run once",
    "dev": "cross-env BROWSER_HEADLESS=false npm run once",
    "test": "jest",
    "clean": "powershell -NoProfile -Command \"if (Test-Path dist) { Remove-Item -Recurse -Force dist }\"",
    "migrate": "ts-node src/scripts/migrate.ts"
  },
  "dependencies": {
    "axios": "^1.7.4",
    "better-sqlite3": "^9.4.3",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.5",
    "node-cron": "^4.2.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.20.0",
    "playwright": "^1.48.2",
    "sqlite3": "^5.1.7",
    "uuid": "^9.0.1",
    "winston": "^3.14.2",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.18.0",
    "@types/uuid": "^9.0.7",
    "flyway": "^0.1.9",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
