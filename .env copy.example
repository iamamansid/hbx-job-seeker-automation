# LLM
GEMINI_API_KEY=your_gemini_api_key_here

# Candidate (required)
CANDIDATE_NAME=
CANDIDATE_EMAIL=
CANDIDATE_PHONE=
CANDIDATE_LINKEDIN_URL=
CANDIDATE_RESUME_PATH=

# Candidate (optional)
CANDIDATE_PORTFOLIO_URL=
CANDIDATE_CURRENT_LOCATION=
WILLING_TO_RELOCATE=true
REQUIRES_SPONSORSHIP=true
VISA_STATUS=
YEARS_EXPERIENCE=3
PRIMARY_SKILLS=Java,Spring Boot,Microservices,REST APIs
SECONDARY_SKILLS=Azure,GCP,Docker,Kubernetes

# Job Search
TARGET_COUNTRY=Australia
TARGET_PORTALS=LinkedIn,Seek,Indeed,ETaxJobs,WorkVisa
VISA_SPONSORSHIP_ONLY=true
MAX_APPLICATIONS_PER_RUN=20
MAX_PAGES_PER_PORTAL=5

# Browser
BROWSER_HEADLESS=true
BROWSER_SLOW_MO=250
BROWSER_TIMEOUT=30000

# Agent
MAX_RETRIES=3
MAX_STEPS=50
ENABLE_AUTO_SUBMIT=false
VERIFICATION_MODE=false

# Storage and logging
DB_PATH=./data/applications.db
MAX_HISTORY_DAYS=90
LOG_LEVEL=info
