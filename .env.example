# SEEK Authentication
# No password needed - SEEK uses email OTP (one-time passcode)
# Run `npm run login-setup` once to authenticate manually in a browser window.
# Your session is stored in PostgreSQL and reused on every run.
# Sessions last approximately 30 days. Re-run login-setup when the bot alerts you.
SEEK_EMAIL=your_seek_email@gmail.com

# PostgreSQL Database
DB_HOST=34.131.245.190
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_db_password

GEMINI_API_KEY=your_existing_gemini_api_key
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
MAX_DAILY_APPLICATIONS=30
MAX_SESSION_APPLICATIONS=15
MAX_PAGES_PER_QUERY=3
DRY_RUN=false
LOG_LEVEL=info

# Optional runtime overrides
BROWSER_HEADLESS=false
RESUME_PATH=./assets/resume.pdf

# These JSON files are replaced by PostgreSQL tables:
# data/jobs.json        -> seek_job table
# data/applied.json     -> seek_job table (status='applied')
# data/session.json     -> seek_browser_session table
# data/blacklist.json   -> seek_blacklist table
